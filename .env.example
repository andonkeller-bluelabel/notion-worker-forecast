# Google Cloud OAuth 2.0 client (Web application) — same pattern as notion-worker-dppt.
# Redirect URI = `ntn workers oauth show-redirect-url`; enable the Google Sheets API.
#   ntn workers env set GOOGLE_CLIENT_ID=... GOOGLE_CLIENT_SECRET=...
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The EXPERIMENTAL Forecast Dashboard sheet the worker writes the fact table into.
# Never point this at the original (16LrGoX...).
FORECAST_SHEET_ID=11B2nldq0THoy_NYhBa7ZAFeb8YWKwn2l_0Rtd0toGyY

# Slack bot token (xoxb-…) with chat:write; used to post run summaries / errors.
SLACK_BOT_TOKEN=
# Channel (id or name) for forecast run notices. Defaults to #forecast-ops.
SLACK_FORECAST_OPS_CHANNEL=C0BUQ3GAGBX

# Optional: "true" to log raw webhook delivery bodies.
FORECAST_DEBUG=
